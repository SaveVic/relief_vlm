# Copy to `.env` (never commit `.env`) and fill in what you need.
# Every value here overrides configs/default.yaml; CLI flags override both.

# --- credentials -------------------------------------------------------------
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- locations ---------------------------------------------------------------
# One folder per panel: <RELIEF_DATA_ROOT>/<panel_id>/{rgb,depth,fusion,cavity,seg2}.png
RELIEF_DATA_ROOT=data/dataset
# Ground truth, split, manifests, run records, usage.csv, eval/
RELIEF_OUTPUT_ROOT=outputs
# Paper figures written by scripts/08_example_figure.py (default: <output root>/figures)
# RELIEF_FIGURES_DIR=

# Alternative config file instead of configs/default.yaml
# RELIEF_CONFIG=configs/default.yaml
# Alternative env file instead of ./.env (set this in the shell, not here)
# RELIEF_ENV_FILE=

# --- optional overrides ------------------------------------------------------
# RELIEF_SEED=20260913          # frozen before the first API call; do not change
# RELIEF_TEMPERATURE=0
# RELIEF_MAX_REPAIRS=1          # must be the same for every model
# RELIEF_SLEEP_S=3
# RELIEF_UPLOAD_MODE=files      # files | data_uri

# --- dataset download (relief fetch) -----------------------------------------
# RELIEF_DRIVE_ZIP_URL=
# RELIEF_DRIVE_FOLDER_URL=
